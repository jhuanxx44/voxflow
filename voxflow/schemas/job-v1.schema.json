{
  "$defs": {
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heartbeat At"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "transcribe",
        "export"
      ],
      "title": "Kind",
      "type": "string"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "phase": {
      "default": "queued",
      "title": "Phase",
      "type": "string"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "request": {
      "additionalProperties": true,
      "title": "Request",
      "type": "object"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "queued"
    },
    "worker_pid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Pid"
    }
  },
  "required": [
    "id",
    "kind",
    "project_id",
    "request"
  ],
  "title": "Job",
  "type": "object"
}
