# ==========================================
# VoxFlow 环境变量配置
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，禁止提交到 git
# ==========================================

# 素材库管理后台密码（上传/删除素材接口）
ADMIN_PASSWORD=replace-with-a-long-random-password

# ===== LLM 文本对话（personal- 前缀 key）=====
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=http://llmapi.provider.example/v1
LLM_MODEL=gemini-3.1-pro

# ===== 图像生成封面（bsk- 前缀 key）=====
IMAGE_API_KEY=replace-with-image-provider-key

# ===== TTS（IndexTTS 服务）=====
TTS_SERVICE_URL=http://cn212000360.provider.example:8000
TTS_DEFAULT_PROMPT_AUDIO=examples/xiaolin.wav
TTS_UPLOAD_ENABLED=true
