# ==========================================
# VoxFlow 环境变量配置
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，禁止提交到 git
# ==========================================

# 素材库管理后台密码（上传/删除素材接口）
ADMIN_PASSWORD=replace-with-a-long-random-value

# ===== LLM 文本对话（可选）=====
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://your-gemini-proxy.example/v1
LLM_MODEL=gemini-2.5-flash

# ===== 图像生成封面（可选）=====
IMAGE_API_KEY=replace-with-your-image-provider-key

# ===== TTS（IndexTTS 兼容服务，可选）=====
TTS_SERVICE_URL=http://127.0.0.1:8000
TTS_DEFAULT_PROMPT_AUDIO=/absolute/path/to/reference.wav
TTS_UPLOAD_ENABLED=false

# ===== Web 安全边界 =====
# 默认只监听本机。只有明确理解无内置多租户认证的风险时才改为 0.0.0.0。
VOXFLOW_WEB_HOST=127.0.0.1
VOXFLOW_WEB_PORT=8082
VOXFLOW_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
